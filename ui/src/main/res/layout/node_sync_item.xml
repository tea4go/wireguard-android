<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <CheckBox
        android:id="@+id/node_sync_item_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/node_sync_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/node_sync_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <RadioGroup
            android:id="@+id/node_sync_item_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/node_sync_item_source_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/gitee_node_sync_use_local" />

            <RadioButton
                android:id="@+id/node_sync_item_source_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/gitee_node_sync_use_server" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/node_sync_item_as_interface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gitee_node_sync_set_as_interface_address"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
